{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Steel Pan App",
        "supportEmail": "spencercharles11@gmail.com"
      }
    }
  },
  "hosting": {
    "source": ".",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/rsvp/**",
        "destination": "/rsvp.html"
      },
      {
        "source": "/rsvp",
        "destination": "/rsvp.html"
      }
    ]
  }
}
